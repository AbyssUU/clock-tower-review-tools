{
  "name": "botc-grimoire-replay",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build --mode electron",
    "build:vercel": "vite build --base=/",
    "preview": "vite preview",
    "dist:mac": "npm run build:electron && electron-builder --mac",
    "dist:win": "npm run build:electron && electron-builder --win",
    "dist": "npm run build:electron && electron-builder --mac --win"
  },
  "dependencies": {
    "framer-motion": "^11.3.19",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.abyss.botc-grimoire-replay",
    "productName": "魔典复盘生成器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "BotC-Grimoire-Replay-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "BotC-Grimoire-Replay-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BotC-Grimoire-Replay-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "BotC-Grimoire-Replay-${version}-portable.${ext}"
    }
  }
}
